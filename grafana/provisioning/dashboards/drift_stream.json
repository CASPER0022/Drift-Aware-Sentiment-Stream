{
  "uid": "drift-stream",
  "title": "Drift Stream",
  "tags": [
    "drift"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-drift"
        },
        "refresh": 2,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"drift\", tag: \"run\", start: -30d)\n  |> sort(desc: true)",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "annotate_model",
        "label": "Drift markers of",
        "type": "custom",
        "query": "enhanced,baseline",
        "current": {
          "text": "enhanced",
          "value": "enhanced"
        },
        "options": [
          {
            "text": "enhanced",
            "value": "enhanced",
            "selected": true
          },
          {
            "text": "baseline",
            "value": "baseline",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Vocabulary detector",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-drift"
        },
        "enable": true,
        "iconColor": "#eb6834",
        "target": {
          "refId": "Anno",
          "query": "from(bucket: \"drift\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"drift_event\" and r.run == \"${run}\" and r.detector == \"vocab\" and r._field == \"text\")\n  |> filter(fn: (r) => r.kind == \"change\" and r.model == \"${annotate_model}\")\n  |> map(fn: (r) => ({_time: r._time, text: r._value}))\n  |> group()\n"
        }
      },
      {
        "name": "ADWIN",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-drift"
        },
        "enable": true,
        "iconColor": "#2a78d6",
        "target": {
          "refId": "Anno",
          "query": "from(bucket: \"drift\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"drift_event\" and r.run == \"${run}\" and r.detector == \"adwin\" and r._field == \"text\")\n  |> filter(fn: (r) => r.kind == \"change\" and r.model == \"${annotate_model}\")\n  |> map(fn: (r) => ({_time: r._time, text: r._value}))\n  |> group()\n"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Accuracy per micro-batch (5-batch moving average)",
      "description": "Prequential accuracy: each tweet is predicted before the model learns it. Annotations mark detected drift (orange: vocabulary detector, blue: ADWIN).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-drift"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-drift"
          },
          "query": "from(bucket: \"drift\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"model_metrics\" and r.run == \"${run}\" and r._field == \"accuracy\")\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: r.model}))\n  |> group(columns: [\"_field\"])\n  |> sort(columns: [\"_time\"])\n  |> movingAverage(n: 5)\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "drawStyle": "line",
            "lineInterpolation": "linear"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "enhanced"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "baseline"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "accumulative"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8a8984"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fading"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1baf7a"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
